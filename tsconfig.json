{
  "compilerOptions": {
    "target": "ES2015",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "api": ["api/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "api/**/*.ts"
  ]
}
